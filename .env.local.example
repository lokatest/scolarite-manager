NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=VOTRE_CLE_ANON_PUBLIC

# Clé de SERVICE Supabase (différente de la clé anon !) — nécessaire
# uniquement pour les tâches planifiées (anti-veille + retry des reçus),
# qui n'ont pas de session utilisateur. À récupérer dans Supabase :
# Project Settings > API > service_role secret.
# ⚠️ Cette clé contourne toutes les règles de sécurité (RLS) : ne
# jamais l'exposer côté client, ne jamais la préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=VOTRE_CLE_SERVICE_ROLE

# Clé publique iLoveAPI (iloveapi.com) — nécessaire pour la conversion
# Word -> PDF du reçu de paiement
ILOVEAPI_PUBLIC_KEY=VOTRE_CLE_PUBLIQUE_ILOVEAPI

# Secret optionnel mais recommandé : protège les routes de tâches
# planifiées (/api/keep-alive, /api/retry-receipts) contre les appels
# externes non autorisés. Vercel l'ajoute automatiquement si tu actives
# "Cron Job Protection" dans les paramètres du projet ; sinon, choisis
# une valeur aléatoire toi-même et mets exactement la même ici et dans
# Vercel (Project Settings > Environment Variables).
CRON_SECRET=UNE_VALEUR_ALEATOIRE_LONGUE

# Identifiants Twilio (twilio.com) — nécessaires pour l'envoi des
# notifications SMS (demande initiée / demande validée).
TWILIO_ACCOUNT_SID=VOTRE_ACCOUNT_SID
TWILIO_AUTH_TOKEN=VOTRE_AUTH_TOKEN
TWILIO_FROM_NUMBER=+17372212163

# Mets "true" UNIQUEMENT si ton compte Twilio est encore en essai gratuit :
# les comptes d'essai interdisent le texte libre et n'autorisent que des
# modèles prédéfinis (imposé par Twilio, pas par ce code). En mode test,
# un modèle générique neutre sera envoyé à la place du vrai message
# (visible en clair dans les logs du serveur pour vérification).
# Une fois ton compte Twilio crédité/passé en payant, retire cette ligne
# (ou mets "false") pour envoyer les vrais messages personnalisés.
TWILIO_TRIAL_MODE=true

# Interrupteurs indépendants : active/désactive chaque canal de
# notification sans avoir à commenter/supprimer de variables. Mets
# "true" pour activer, "false" (ou retire la ligne) pour désactiver.
SMS_NOTIFICATIONS_ENABLED=false
EMAIL_NOTIFICATIONS_ENABLED=true

# Identifiants SendGrid (app.sendgrid.com) — nécessaires pour l'envoi
# des notifications par email (demande initiée / demande validée).
SENDGRID_API_KEY=VOTRE_CLE_API_SENDGRID
# Doit être exactement l'adresse vérifiée via "Single Sender Verification"
SENDGRID_FROM_EMAIL=votre-adresse-verifiee@exemple.com
SENDGRID_FROM_NAME=Scolarité Manager
